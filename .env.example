# Credenciales de Gavriel para el MCP server.
# Copiá este archivo a `.env` y completá los valores. NO committees `.env`.

GAVRIEL_EMAIL=
GAVRIEL_PASSWORD=
GAVRIEL_API_BASE=https://app.gavriel.com.ar/api

# Opcional: token de dispositivo confiable (normalmente va al keyring del
# sistema, no acá; este es fallback de dev).
# GAVRIEL_TRUSTED_DEVICE_TOKEN=

# Opcional: rol del server (default full).
# readonly: solo tools de lectura (+ `get` y `audit_logs`).
# lite: lectura + escrituras core (tickets, intervenciones, conversaciones).
# full: todas las tools, incluidas las de escritura.
# GAVRIEL_MCP_ROLE=readonly

# Opcional: dónde se escribe writes.log (default: ~/.local/share/gavriel-mcp)
# GAVRIEL_MCP_LOG_DIR=

# Opcional: máximo de escrituras en vuelo (1–20, default 5).
# GAVRIEL_MCP_WRITE_CONCURRENCY=5

# Opcional: aprobación humana por elicitation para tools destructivas
# (default off).
# GAVRIEL_MCP_DESTRUCTIVE_APPROVAL=off