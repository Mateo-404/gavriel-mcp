{
  "name": "gavriel-mcp",
  "version": "1.2.0",
  "description": "MCP server local que expone la API de Gavriel (alarmas) como herramientas para agentes de IA",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gavriel-mcp": "dist/index.js",
    "gavriel": "dist/cli.js"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "selfcheck": "node scripts/selfcheck.mjs",
    "regression": "node scripts/regression.mjs",
    "build:bin": "node scripts/build-bin.mjs",
    "test:fast": "node scripts/selfcheck.mjs",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\"",
    "test:snapshot": "tsc -p tsconfig.json && UPDATE_SNAPSHOT=1 node --test test/contract.test.mjs",
    "lint": "biome lint src test scripts",
    "format": "biome format src test",
    "mcpb:pack": "mcpb pack"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ]
}
