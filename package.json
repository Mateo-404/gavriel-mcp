{
  "name": "gavriel-mcp",
  "version": "1.2.0",
  "description": "MCP server local que expone la API de Gavriel (alarmas) como herramientas para agentes de IA",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gavriel-mcp": "dist/index.js"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "selfcheck": "node scripts/selfcheck.mjs",
    "regression": "node scripts/regression.mjs",
    "build:bin": "node scripts/build-bin.mjs",
    "test:fast": "bun run selfcheck"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}