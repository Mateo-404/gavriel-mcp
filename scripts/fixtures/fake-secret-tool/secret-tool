#!/usr/bin/env node
// Fake `secret-tool` para tests: simula el keyring del sistema con un archivo
// JSON de estado (ver env FAKE_KEYRING_STATE). Entiende el mismo subconjunto
// de `secret-tool lookup|store|clear service <s> account <a>` que usa
// src/secrets.ts — nada más. No es un mock del comportamiento real de
// libsecret, solo lo suficiente para probar el orden de fallback del cliente.
import { readFileSync, writeFileSync } from "node:fs";

const statePath = process.env.FAKE_KEYRING_STATE;
if (!statePath) {
  console.error("FAKE_KEYRING_STATE no seteado");
  process.exit(2);
}

function loadState() {
  try {
    return JSON.parse(readFileSync(statePath, "utf8"));
  } catch {
    return {};
  }
}
function saveState(state) {
  writeFileSync(statePath, JSON.stringify(state));
}

const args = process.argv.slice(2);
const cmd = args[0];
const rest = args.slice(1).filter((a) => !a.startsWith("--label="));
const service = rest[rest.indexOf("service") + 1] ?? "";
const account = rest[rest.indexOf("account") + 1] ?? "";
const key = `${service}:${account}`;

if (cmd === "lookup") {
  const state = loadState();
  if (!(key in state)) process.exit(1);
  process.stdout.write(state[key]);
  process.exit(0);
} else if (cmd === "store") {
  let input = "";
  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (d) => (input += d));
  process.stdin.on("end", () => {
    const state = loadState();
    state[key] = input;
    saveState(state);
    process.exit(0);
  });
} else if (cmd === "clear") {
  const state = loadState();
  delete state[key];
  saveState(state);
  process.exit(0);
} else {
  console.error(`comando no soportado por el fake secret-tool: ${cmd}`);
  process.exit(2);
}
