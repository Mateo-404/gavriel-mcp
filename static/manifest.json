{
  "manifest_version": 3,
  "name": "Gavriel Tools",
  "version": "0.0.0",
  "description": "Gavriel más rápido y sin ruido: atajos de teclado, llamadas con un toque, sonidos silenciados y carga veloz del panel de monitoreo.",
  "homepage_url": "https://github.com/Mateo-404/gavriel-mcp/tree/gavriel-extension",
  "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "notifications"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "cache", "enabled": true, "path": "rules/cache.json" },
      { "id": "fonts", "enabled": true, "path": "rules/fonts.json" }
    ]
  },
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["https://app.gavriel.com.ar/*"] }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gavriel Tools: sonidos y atajos",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.gavriel.com.ar/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.gavriel.com.ar/*"],
      "js": ["content/main.js"],
      "css": ["content/shortcuts.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://open.spotify.com/*", "https://music.youtube.com/*"],
      "js": ["content/music.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.gavriel.com.ar/*"],
      "js": ["content/mute.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
