{
  "manifest_version": 3,
  "name": "Gavriel Tools",
  "version": "0.0.0",
  "description": "Herramientas extra para Gavriel: silenciar los sonidos del panel de monitoreo y atajos de teclado para llamar.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Gavriel Tools",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.gavriel.com.ar/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://app.gavriel.com.ar/*"],
      "js": ["content/account.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.gavriel.com.ar/*"],
      "js": ["content/shortcuts.js"],
      "css": ["content/shortcuts.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.gavriel.com.ar/*"],
      "js": ["content/mute.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
