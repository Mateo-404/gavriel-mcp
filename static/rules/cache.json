[
  {
    "id": 1,
    "priority": 1,
    "action": {
      "type": "modifyHeaders",
      "responseHeaders": [
        { "header": "cache-control", "operation": "set", "value": "public, max-age=31536000, immutable" },
        { "header": "pragma", "operation": "remove" },
        { "header": "expires", "operation": "remove" }
      ]
    },
    "condition": {
      "regexFilter": "^https://app\\.gavriel\\.com\\.ar/assets/[^/?#]+-[A-Za-z0-9_-]{8}\\.(js|css|woff2?|ttf|svg|png|jpe?g|webp|gif)$",
      "initiatorDomains": ["app.gavriel.com.ar"],
      "resourceTypes": ["script", "stylesheet", "font", "image", "xmlhttprequest", "other"]
    }
  }
]
